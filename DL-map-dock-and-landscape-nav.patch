 /* the modifier pill on the details page: centred text, one steady size (touch rules used to stretch it) */
 .cd-ab .cd-ab-mod { display: inline-flex; align-items: center; justify-content: center; min-width: 52px; min-height: 28px; padding: 0 10px; line-height: 1; box-sizing: border-box; }
+
+
+/* ---- phone map toolbar: a floating tool dock at the bottom, in reach of the thumb ----
+   Portrait: a slim bar (Tools, undo/redo, zoom) with the full tool tray rising out of it.
+   Sideways: every tool on one line, with a chevron that tucks the dock down to a single pill. */
+@media (max-width: 880px), (max-height: 500px) and (orientation: landscape) {
+  :root { --dock-h: 46px; }
+  .map-content-area { padding-bottom: calc(var(--dock-h) + 14px); }
+  .map-toolbar {
+    position: fixed; z-index: 75; inset-inline: 8px; margin: 0; top: auto;
+    bottom: calc(var(--bar-h) + 8px + env(safe-area-inset-bottom));
+    padding: 5px 6px; gap: 6px; border-radius: 16px;
+    background: color-mix(in srgb, var(--bg-void-2) 86%, transparent);
+    -webkit-backdrop-filter: blur(22px) saturate(160%); backdrop-filter: blur(22px) saturate(160%);
+    border: 1px solid var(--hairline-strong); box-shadow: var(--shadow-deep);
+    transition: bottom 0.28s var(--ease-drawer);
+  }
+  .map-toolbar.is-pinned { border-radius: 16px; border-top-color: var(--hairline-strong); }
+  /* the dock sits at the bottom, so tool menus always open upward (the "pinned to the top" flip does not apply) */
+  .map-toolbar.is-pinned .tool-flyout-menu { bottom: 100%; top: auto; padding-top: 0; padding-bottom: 14px; transform: translate(-50%, 4px); }
+  .map-toolbar.is-pinned .tool-flyout:hover .tool-flyout-menu, .map-toolbar.is-pinned .tool-flyout.open .tool-flyout-menu { transform: translate(-50%, 0); }
+  .map-toolbar > * { order: 2; }
+  .map-toolbar .map-tool-group--more { order: 0; }
+  .map-toolbar #fog-options-group, .map-toolbar #shape-style-group { order: 1; flex: 1 1 100%; padding: 2px 4px 4px; }
+  .map-toolbar > .map-tool-group:not(.map-tool-group--more):not(.map-tool-group-persistent):not(#shape-style-group):not(#fog-options-group) { order: 3; }
+  .map-toolbar .map-tool-group-persistent { order: 4; margin-inline-start: auto; }
+  .map-toolbar #map-locked-banner { order: 2; }
+  .map-toolbar .map-toolbar-toggle {
+    display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 10px 0 8px; border-radius: 12px;
+    background: rgba(201,162,75,0.10); border: 1px solid rgba(201,162,75,0.28); color: var(--parchment);
+  }
+  .map-toolbar .map-toolbar-toggle .icon:last-child { transform: rotate(180deg); transition: transform 0.24s var(--ease-drawer); }
+  .map-toolbar.is-open .map-toolbar-toggle .icon:last-child { transform: rotate(0deg); }
+  .map-toolbar.is-open .map-tool-group--more {
+    display: flex; flex: 1 1 100%; flex-wrap: wrap; justify-content: flex-start; gap: 6px; padding: 4px 2px 8px; border-bottom: 1px solid var(--hairline);
+    animation: dock-tray-in 0.26s var(--ease-drawer) both;
+  }
+  .modifier-hint, #nav-hint { bottom: calc(var(--bar-h) + var(--dock-h) + 22px + env(safe-area-inset-bottom)); }
+  .bars-hidden .modifier-hint, .bars-hidden #nav-hint { bottom: calc(var(--dock-h) + 22px + env(safe-area-inset-bottom)); }
+  .pin-action-bubble.is-docked { bottom: calc(var(--bar-h) + var(--dock-h) + 22px + env(safe-area-inset-bottom)); }
+  .bars-hidden .pin-action-bubble.is-docked { bottom: calc(var(--dock-h) + 22px + env(safe-area-inset-bottom)); }
+}
+@keyframes dock-tray-in { from { opacity: 0; transform: translateY(10px) scale(0.98); } to { opacity: 1; transform: none; } }
+
+@media (orientation: landscape) and (max-height: 500px) {
+  :root { --dock-h: 44px; }
+  .map-toolbar { inset-inline-start: 98px; inset-inline-end: 10px; bottom: calc(var(--bar-h) + 10px + env(safe-area-inset-bottom)); flex-wrap: nowrap; padding: 4px 6px; gap: 6px; }
+  .bars-hidden .map-toolbar { bottom: calc(10px + env(safe-area-inset-bottom)); }
+  .map-toolbar .map-toolbar-toggle { order: 0; flex: 0 0 auto; }
+  .map-toolbar .map-tool-group--more, .map-toolbar.is-open .map-tool-group--more {
+    order: 1; display: flex; flex: 0 0 auto; flex-wrap: nowrap; padding: 0 6px 0 0; border-bottom: 0; border-inline-end: 1px solid var(--hairline); animation: none;
+  }
+  .map-toolbar #fog-options-group, .map-toolbar #shape-style-group { order: 2; flex: 0 0 auto; padding: 0 6px 0 0; }
+  .map-toolbar .map-toolbar-toggle .icon:last-child { transform: rotate(90deg); }              /* points at the side it folds away to */
+  .map-toolbar.is-tucked .map-toolbar-toggle .icon:last-child { transform: rotate(-90deg); }
+  .map-toolbar.is-tucked { inset-inline-end: auto; }
+  .map-toolbar.is-tucked > *:not(.map-toolbar-toggle) { display: none !important; }
+  .map-toolbar:not(.is-tucked) { animation: dock-tray-in 0.26s var(--ease-drawer) both; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .map-toolbar, .map-toolbar.is-open .map-tool-group--more, .map-toolbar:not(.is-tucked) { animation-duration: 0.01ms; transition-duration: 0.01ms; }
+}
+
+/* ---- sideways phone: the bottom bar's tabs are centred (icon and label together), not left-aligned ---- */
+@media (orientation: landscape) and (max-height: 500px) {
+  .sidebar-nav .nav-tab, :root[data-sidebar="collapsed"] .sidebar-nav .nav-tab { justify-content: center; text-align: center; }
+  .sidebar-nav .nav-tab span { text-align: center; }
+}
