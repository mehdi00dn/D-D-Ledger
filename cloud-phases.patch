+  }
+
+  async function stage(file, purpose) {
+    var res = await fetch('/uploads/sign', {
+      method: 'POST', credentials: 'same-origin',
+      headers: Object.assign({ 'Content-Type': 'application/json' }, csrfHeaders()),
