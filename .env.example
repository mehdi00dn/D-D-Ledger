# Copy to .env for local development (never commit the real file).

# Postgres connection string.
#   Supabase + Vercel: use the *Transaction pooler* string (port 6543) from
#   Project Settings -> Database -> Connection string, and append ?sslmode=require
#   Local dev:         postgresql://postgres:postgres@localhost:5432/ledger
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger

# Signs login cookies.  Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local development only: apply pending migrations automatically at startup.
AUTO_MIGRATE=1

# --- File storage --------------------------------------------------------------
# Local development stores uploads in ./uploads (nothing to configure).
# To use Supabase Storage instead (this is what Vercel requires), set both:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...          # server-side only, never expose to browsers
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # optional: real-time updates (public by design; REALTIME_ENABLED=0 turns it off)
# Optional overrides: STORAGE_BACKEND=local|supabase, STORAGE_BUCKET_UPLOADS, STORAGE_BUCKET_TEMP

# --- Logging and error tracking (all optional) ----------------------------------
# LOG_FORMAT=json|text      # default: json on Vercel, text locally
# LOG_LEVEL=INFO
# SENTRY_DSN=               # also requires sentry-sdk in requirements

# --- Email (optional) -------------------------------------------------------------
# Plain SMTP, so any transactional provider works (Resend, Postmark, Brevo, Amazon SES, Mailgun ...): copy the SMTP
# settings from the provider's dashboard.  Without MAIL_HOST, mail is only logged locally and switched off on Vercel,
# and the account page says addresses cannot be confirmed yet.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587                 # 465 with MAIL_SECURITY=ssl
# MAIL_SECURITY=starttls        # starttls | ssl | none
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM="Campaign Ledger <no-reply@yourdomain.com>"    # the domain needs SPF + DKIM records from the provider
# MAIL_BACKEND=smtp|console|off # normally leave unset
# MAIL_LIMIT_USER=5  MAIL_LIMIT_ADDRESS=3  MAIL_LIMIT_IP=20   # emails per hour

# Image storage quotas in MB (0 = no limit)
# LEDGER_QUOTA_USER_MB=150
# LEDGER_QUOTA_CAMPAIGN_MB=300
