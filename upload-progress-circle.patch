+  // the redirect chain and navigating to wherever it ends is equivalent to what a
+  // native submission would have done either way.
+  function submitFormWithProgress(form) {
+    return new Promise(function (resolve, reject) {
+      var xhr = new XMLHttpRequest();
+      xhr.open(form.method || 'POST', form.action);
+      xhr.upload.onprogress = function (e) { if (e.lengthComputable) setProgress(form, e.loaded / e.total); };
