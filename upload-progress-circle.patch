diff --git a/static/css/style.css b/static/css/style.css
index 665ec97..8e5377e 100644
--- a/static/css/style.css
+++ b/static/css/style.css
@@ -1201,6 +1201,32 @@ body.page-leaving .content {
   100% { transform: translateX(250%); }
 }
 
+/* Circular variant -- used over avatar/map-image previews, where a thin bar
+   below the frame doesn't read as "this image" the way a ring on top of it
+   does. Same .upload-progress element/JS, just a different look: a compound
+   selector (.upload-progress.upload-progress-circle) so it wins over the
+   linear rules above regardless of source order. */
+.upload-progress.upload-progress-circle {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  right: auto;
+  bottom: auto;
+  transform: translate(-50%, -50%);
+  width: 34px;
+  height: 34px;
+  border: none;
+  border-radius: 50%;
+  background: conic-gradient(var(--brass) calc(var(--pct, 0) * 1%), rgba(11, 13, 19, 0.65) 0);
+  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 4px));
+          mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 4px));
+}
+.upload-progress.upload-progress-circle.is-indeterminate {
+  background: conic-gradient(var(--brass) 0 25%, rgba(11, 13, 19, 0.65) 0);
+  animation: upload-ring-spin 0.9s linear infinite;
+}
+@keyframes upload-ring-spin { to { transform: rotate(360deg); } }
+
 .banner-notice {
   padding: 12px 16px;
   border-radius: var(--radius-s);
