+    END IF;
+END $$;
+
+CREATE UNIQUE INDEX idx_users_username_ci ON users (lower(username));
+
+INSERT INTO schema_migrations (version) VALUES ('0005_case_insensitive_usernames.sql');
+
 COMMIT;
