@@ -130,11 +130,11 @@
 <div class="form-panel members-panel">
   <div class="form-section" style="margin-bottom:0;">
     <p class="form-section-title">Members</p>
-    <div class="member-list">
+    <div class="member-list" id="member-list">
       {% for m in members %}
-      <div class="member-row">
