+
+
+/* ---- phone map dock, round 2: centred, no stray gap, tray grouped as "tools" over "map" ---- */
+@media (max-width: 880px), (max-height: 500px) and (orientation: landscape) {
+  .map-toolbar { width: fit-content; max-width: calc(100% - 16px); margin-inline: auto; justify-content: center; }
+  .map-toolbar.is-open { width: auto; margin-inline: 8px; }                                     /* the open tray uses the whole width */
+  .map-toolbar .map-tool-group-persistent, .map-toolbar .map-tool-group:last-child { margin-inline-start: 0; }
+  .map-toolbar #hold-space-hint { display: none; }
+  /* the tray: the six drawing tools as one even row, the map actions (clear, grid, hide new) as a second row */
+  .map-toolbar.is-open .map-tool-group--more { border-bottom: 0; padding: 0; gap: 6px; animation: dock-tray-in 0.26s var(--ease-drawer) both; }
+  .map-toolbar.is-open .map-tool-group--more:first-of-type { flex: 1 1 100%; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
+  .map-toolbar.is-open .map-tool-group--more:first-of-type > *, .map-toolbar.is-open .map-tool-group--more:first-of-type .tool-flyout { width: 100%; }
+  .map-toolbar.is-open .map-tool-group--more:first-of-type .map-tool-btn { width: 100%; }
+  .map-toolbar.is-open .map-tool-group--more:has(#clear-drawings-btn) { flex: 1 1 0; }
+  .map-toolbar.is-open #clear-drawings-btn { width: 100%; justify-content: center; min-height: var(--ctl); }
+  .map-toolbar.is-open .map-tool-group--more:has(#grid-settings-btn) { flex: 0 0 auto; }
+  .map-toolbar.is-open .map-tool-group--more:has(#clear-drawings-btn) + .map-tool-group--more { padding: 0; }
+}
+@media (orientation: landscape) and (max-height: 500px) {
+  .map-toolbar { inset-inline: 98px 10px; max-width: none; }
+  .map-toolbar.is-open { margin-inline: auto; width: fit-content; }
+  .map-toolbar.is-open .map-tool-group--more:first-of-type { display: flex; flex: 0 0 auto; }
+  .map-toolbar.is-open .map-tool-group--more:first-of-type .map-tool-btn { width: var(--ctl); }
+  .map-toolbar.is-open .map-tool-group--more:has(#clear-drawings-btn) { flex: 0 0 auto; }
+  .map-toolbar.is-open #clear-drawings-btn { width: auto; }
+}
+@media (max-width: 880px) and (orientation: portrait), (max-width: 880px) and (min-height: 501px) {
+  .map-toolbar.is-open::before { content: ''; order: 1; flex: 0 0 100%; height: 0; }            /* the tray is its own block; the Tools / undo / zoom bar starts a new line */
+}
diff --git a/static/js/sheet-viewer.js b/static/js/sheet-viewer.js
index 26c480a..71d1511 100644
--- a/static/js/sheet-viewer.js
+++ b/static/js/sheet-viewer.js
@@ -11,9 +11,25 @@
   var next = panel.querySelector('[data-sheet-next]');
   var index = 0;
 
+  // The same page turn as the lightbox (220 ms, ease-out, interruptible; reduced motion = a short fade), hinged on the side it came from.
+  var turn = null;
+  var calm = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };
+  function pageTurn(direction) {
+    if (turn) { turn.cancel(); turn = null; }
+    if (!img.animate || !direction) return;
+    var forward = direction > 0, origin = forward ? 'left center' : 'right center';
+    var from = calm.matches ? { opacity: 0.4 } : { opacity: 0.35, transform: 'perspective(1100px) rotateY(' + (forward ? -24 : 24) + 'deg) scale(0.985)', transformOrigin: origin };
+    var to = calm.matches ? { opacity: 1 } : { opacity: 1, transform: 'perspective(1100px) rotateY(0deg) scale(1)', transformOrigin: origin };
+    turn = img.animate([from, to], { duration: calm.matches ? 120 : 220, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' });
+    turn.onfinish = turn.oncancel = function () { turn = null; };
+  }
+
   function show(i) {
+    var before = index;
     index = Math.max(0, Math.min(thumbs.length - 1, i));
+    var changed = index !== before;
     img.src = thumbs[index].dataset.sheetSrc;
+    if (changed) pageTurn(index > before ? 1 : -1);
     thumbs.forEach(function (t, n) { t.parentNode.classList.toggle('is-active', n === index); });
     if (count) count.textContent = (index + 1) + ' / ' + thumbs.length;
     if (prev) prev.disabled = index === 0;
